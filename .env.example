# Triage Inbox — Environment Variables Template
# Copy this file to .env: cp .env.example .env

# Provider choice: openai | anthropic | groq | openrouter  (default: openai)
TRIAGE_PROVIDER=openai

# Model override (optional; defaults to the provider's default if omitted).
# The headline benchmark uses gpt-4o.
# OpenAI: gpt-4o-mini (default), gpt-4o
# Anthropic: claude-opus-5, claude-sonnet-5, claude-haiku-4-5
# Groq: openai/gpt-oss-120b
# OpenRouter: anthropic/claude-sonnet-4.5
TRIAGE_MODEL=gpt-4o

# Effort level (high | medium | low) — Anthropic provider only
TRIAGE_EFFORT=high

# API Keys (only set the key for the provider you choose)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
