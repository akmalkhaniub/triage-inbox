# Triage Inbox — Environment Variables Template
# Copy this file to .env: cp .env.example .env

# Provider choice: anthropic | openai | groq | openrouter
TRIAGE_PROVIDER=anthropic

# Model override (optional, defaults to provider's default if omitted)
# Anthropic: claude-opus-5, claude-sonnet-5, claude-haiku-4-5
# OpenAI: gpt-4o-mini, gpt-4o
# Groq: openai/gpt-oss-120b
# OpenRouter: anthropic/claude-sonnet-4.5
TRIAGE_MODEL=claude-opus-5

# Effort level (high | medium | low) — Anthropic provider only
TRIAGE_EFFORT=high

# API Keys (only set the key for the provider you choose)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
